# ── Python Backend ────────────────────────────────────────────────────────────
# .venv is the virtual environment uv creates -- contains all Python packages.
# Never commit this: it's large, machine-specific, and reproducible via uv sync.
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/.ruff_cache/

# ── Frontend / Node ───────────────────────────────────────────────────────────
# node_modules contains all npm packages -- reproducible via npm install.
app/node_modules/
app/dist/
app/dist-ssr/
*/local

# ── Tauri / Rust ──────────────────────────────────────────────────────────────
# Rust build artifacts -- large and fully reproducible via cargo build.
app/src-tauri/target/

# ── Backend bundling ──────────────────────────────────────────────────────────
# PyInstaller intermediates: build/ and dist/ are throwaway, regenerated
# every release. scripts/build-backend.ps1 copies the real .exe into
# app/src-tauri/binaries/ where Tauri picks it up.
backend/build/
backend/dist/

# Real PyInstaller-built sidecar binaries are 20-80 MB and reproducible, so
# they are NEVER committed. They are built fresh on every release:
#   - in CI:   .github/workflows/build-windows.yml  (PyInstaller step)
#   - locally: scripts/build-backend.ps1
# The actual ignore rule lives next to the binaries so it matches every
# Tauri platform target (see app/src-tauri/binaries/.gitignore). Repeated
# here as a backstop so the rule applies regardless of local folder layout.
app/src-tauri/binaries/open-write-backend-*

# ── Release artifacts ────────────────────────────────────────────────────────
# scripts/release.ps1 stages .msi, .sig, latest.json here before manual
# upload to GitHub Releases. Nothing here belongs in git.
release-artifacts/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*

# ── OS Files ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Secrets (never commit these) ──────────────────────────────────────────────
# The user's OpenRouter API key will be stored here locally.
.env
.env.local
*.env

# ── Open-Write Writing Projects ──────────────────────────────────────
# The .open-write folder inside each writing project holds the SQLite database,
# cache, and logs. It's safe to delete; Open-Write rebuilds it from the Markdown.
**/.open-write/
.claude/settings.local.json

# ── Local developer reference material (not source) ──────────────────────────
# .test-files/ holds local screenshots and scratch files used for planning
# (UI mockups the writer drags in, etc). chapter_summary_ai_instructions.md
# is the writer's private prompt draft -- the authoritative copy lives inside
# backend/app/ai/prompts.py as CHAPTER_SUMMARY_INSTRUCTIONS.
.test-files/
chapter_summary_ai_instructions.md
